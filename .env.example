# Cleaning Schedule Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The agent reads reservations and reservation notes to decide
# checkouts, stayovers, bed setups, mid-stay cleans, etc.
# Reference setup uses Cloudbeds, but any PMS with reservation
# lookup + reservation-notes endpoints works.

PMS_LOOKUP_TOOL="tools/lookup_guest.py"
PMS_API_TOOL="tools/cloudbeds_api.py"
PMS_NOTES_TOOL="tools/cloudbeds_notes.py"
PMS_PROPERTY_ID=""

# Cloudbeds reference values (only needed if you use Cloudbeds):
# CLOUDBEDS_CLIENT_ID=""
# CLOUDBEDS_CLIENT_SECRET=""
# CLOUDBEDS_ACCESS_TOKEN=""
# CLOUDBEDS_REFRESH_TOKEN=""

# ============================================================
# Cleaning schedule sheet
# ============================================================
# Google Sheet that holds the published schedule. The agent
# reads the System tab (staff config) and writes the Schedule
# tab (day-by-day plan).

SHEET_ID_TASKS=""

# ============================================================
# Email + sheets CLI
# ============================================================
# Command-line wrapper that can read/write Sheets and create
# Gmail drafts for the staff schedule emails.

EMAIL_CLI="gws"

# ============================================================
# Property config
# ============================================================
# Number of cleanable rooms in the hotel (used for linen-stock
# calculations). If you also rent the whole property, set
# WHOLE_PROPERTY_RENTAL=true so villa-rental rules apply when
# all rooms are blocked.

NUM_ROOMS=6
WHOLE_PROPERTY_RENTAL=false

# ============================================================
# Staff contacts (for handoff / schedule emails)
# ============================================================
# Comma-separated. Used by the staff-email step to deliver each
# person's individual schedule.

STAFF_CONTACT_EMAILS=""
STAFF_CONTACT_NUMBERS=""
